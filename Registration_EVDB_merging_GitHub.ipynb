    "\n",
    "        try:\n",
    "\n",
    "            url = f\"{BASE_URL}/vehicles/{vehicle_id}.json\"\n",
    "\n",
    "            vehicle_response = requests.get(\n",
    "                url,\n",
    "                timeout=60\n",
    "            )\n",
    "            vehicle_response.raise_for_status()\n",
