    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import matplotlib.pyplot as plt\n",
    "import ast\n",
    "import numpy as np\n",
    "\n",
    "# ==================================================\n",
    "# INPUTS\n",
    "# ==================================================\n",
    "\n",
    "# root_folder\n",
    "ROOT_FOLDER = r'C:\\...'\n",
    "\n",
    "# Input files\n",
    "REG_FILE = ROOT_FOLDER + r'\\TieliikenneAvoinData_31_12_2025_cleaned.csv'\n",
    "EVDB_FILE = ROOT_FOLDER + r'\\EVDB_brand_model_statistics.csv'\n",
    "\n",
    "# Output files\n",
    "OUTPUT_FILE = ROOT_FOLDER + r'\\EV_registration_EVDB_merged.csv'\n",
    "\n",
    "# ==================================================\n",
    "# LOAD & INSPECT DATA\n",
    "# ==================================================\n",
    "print(\"Loading registration data...\")\n",
    "df_reg = pd.read_csv(REG_FILE, sep=\";\", low_memory=False)\n",
    "\n",
    "print(f\"Registrations: {len(df_reg):,}\")\n",
    "\n",
    "# Unique EV models in registration and EVDB data\n",
    "reg_original_models = (df_reg[[\"merkkiSelvakielinen\", \"kaupallinenNimi\"]].drop_duplicates())\n",
    "print(f\"Unique models in raw registration data (merkkiSelvakielinen + kaupallinenNimi): {len(reg_original_models):,}\")\n",
    "\n",
    "# Unique EV models in registration data (brand_model)\n",
    "unique_reg_brand_model = df_reg[\"brand_model\"].nunique()\n",
    "print(f\"Unique EV 'brand_model's in registration data: {unique_reg_brand_model:,}\")\n",
    "\n",
    "# Unique EV models in registration data (brand_model_new)\n",
    "unique_reg_brand_model_new = df_reg[\"brand_model_new\"].nunique()\n",
    "print(f\"Unique EV 'brand_model_new's in registration data: {unique_reg_brand_model_new:,}\\n\")\n",
    "\n",
    "print(\"Loading EVDB data...\")\n",
    "df_evdb = pd.read_csv(EVDB_FILE, sep=\";\", decimal=\",\", low_memory=False)\n",
    "print(f\"EVDB rows: {len(df_evdb):,}\")\n",
    "df_evdb_unique = (df_evdb.sort_values(\"vehicle_count\", ascending=False).drop_duplicates(subset=[\"brand_model\"]))\n",
    "print(f\"Unique EVDB brand_models: {len(df_evdb_unique):,}\")\n",
    "\n",
    "# =============================================================\n",
    "# STEP 1:\n",
    "# Check upper level match between EVDB and EV registration data\n",
    "# =============================================================\n",
    "print(\"STEP 1: Broad hierarchy matching\")\n",
    "\n",
    "step1 = df_reg.merge( df_evdb_unique, how=\"left\", left_on=\"brand_model_new\", right_on=\"brand_model\", suffixes=(\"\", \"_evdb\"))\n",
    "step1[\"match_source\"] = step1[\"brand_model\"].notna().map({True: \"brand_model_new\", False: \"\"})\n",
    "step1[\"matched_evdb_brand_model\"] = step1[\"brand_model\"]\n",
    "upper_level_match_mask = step1[\"vehicle_count\"].notna()\n",
    "print(f\"Upper level matches found: {upper_level_match_mask.sum():,}\")\n",
    "\n",
    "# check unique brand_model matches\n",
    "step1_unique_matches = (step1.loc[upper_level_match_mask, \"matched_evdb_brand_model\"].nunique())\n",
    "print(f\"STEP 1 unique brand_models matched: {step1_unique_matches:,}\")\n",
    "\n",
    "print(\"\\n===================================================\")\n",
    "print(\"MATCH BREAKDOWN\")\n",
    "print(\"===================================================\")\n",
    "\n",
    "print(step1[\"match_source\"].value_counts(dropna=False))\n",
    "\n",
    "# ================================================================\n",
    "# STEP 2:\n",
    "# overwrite step1 result if more detailed match in step 2 is found\n",
    "# ================================================================\n",
    "print(\"STEP 2: Detailed hierarchy matching\")\n",
    "\n",
    "step2 = df_reg.merge(df_evdb_unique, how=\"left\", on=\"brand_model\", suffixes=(\"\", \"_detail\"))\n",
    "detail_match_mask = step2[\"vehicle_count\"].notna()\n",
    "print(f\"Detailed matches found: {detail_match_mask.sum():,}\")\n",
    "\n",
    "# ==================================================\n",
    "# OVERWRITE WITH DETAILED MATCH\n",
    "# ==================================================\n",
    "evdb_cols = [c for c in df_evdb_unique.columns if c != \"brand_model\"]\n",
    "\n",
    "for col in evdb_cols:\n",
    "    detail_col = col\n",
    "    step1.loc[detail_match_mask, col] = (step2.loc[detail_match_mask, detail_col])\n",
    "\n",
    "step1.loc[detail_match_mask, \"matched_evdb_brand_model\"] = (step2.loc[detail_match_mask, \"brand_model\"])\n",
    "step1.loc[detail_match_mask, \"match_source\"] = \"brand_model\"\n",
    "\n",
    "# Create a new column to indicate whether EV statistics were found or not\n",
    "step1[\"EV_reg_EVDB_match\"] = \"EV statistics not found\"\n",
    "step1.loc[(step1[\"brand_model_evdb\"] == step1[\"brand_model_new\"]) & (step1[\"brand_model_evdb\"].notna()), \"EV_reg_EVDB_match\"] = \"Matched in upper level (step 1)\"\n",
    "step1.loc[(step1[\"brand_model_evdb\"] == step1[\"brand_model\"]) & (step1[\"brand_model_evdb\"].notna()), \"EV_reg_EVDB_match\"] = \"Matched in lower level (step 2)\"\n",
    "\n",
    "matched = step1[\"vehicle_count\"].notna().sum()\n",
    "unmatched = len(step1) - matched\n",
    "total_brands = (step1[\"brand_model\"].str.split(\"_\").str[0].nunique())\n",
    "matched_brands = (step1.loc[step1[\"brand_model_evdb\"].notna(), \"brand_model\"].str.split(\"_\").str[0].nunique())\n",
    "unmatched_brands = total_brands - matched_brands\n",
    "unmatched_models = (step1.loc[step1[\"EV_reg_EVDB_match\"] == \"EV statistics not found\", \"brand_model\"].nunique())\n",
    "matched_models = (step1.loc[step1[\"EV_reg_EVDB_match\"] != \"EV statistics not found\", \"brand_model\"].nunique())\n",
    "step1_models = (step1.loc[step1[\"EV_reg_EVDB_match\"] == \"Matched in upper level (step 1)\", \"brand_model\"].nunique())\n",
    "step2_models = (step1.loc[step1[\"EV_reg_EVDB_match\"] == \"Matched in lower level (step 2)\", \"brand_model\"].nunique())\n",
    "\n",
    "# Uncertainties for usable battery capacity\n",
    "battery_unc = pd.to_numeric(step1[\"battery_usable_kwh_relative_spread\"], errors=\"coerce\")\n",
    "fleet_battery_unc = battery_unc.fillna(1.0)\n",
    "\n",
    "# Uncertainties for WLTP energy consumption\n",
    "cons_unc = pd.to_numeric(step1[\"consumption_wltp_kwh_100km_relative_spread\"], errors=\"coerce\")\n",
    "fleet_cons_unc = cons_unc.fillna(1.0)\n",
    "\n",
    "# Fix brands and Skoda brand naming\n",
    "step1[\"brand\"] = (step1[\"brand\"].astype(str).str.replace(r'^\\[\"', '', regex=True).str.replace(r'\"\\]$', '', regex=True).replace({\"ŠKODA\": \"Skoda\", \"Škoda\": \"Skoda\", \"\\\\u0160koda\": \"Skoda\", \"u0160koda\": \"Skoda\", \"[\\\"\\\\u0160koda\\\"]\": \"Skoda\", \"nan\": np.nan}))\n",
    "\n",
    "# ==================================================\n",
    "# SAVE\n",
    "# ==================================================\n",
    "step1.to_csv(OUTPUT_FILE, sep=\";\", index=False)\n",
    "print(f\"\\nSaved:\")\n",
    "print(Path(OUTPUT_FILE).resolve())\n",
    "\n",
    "# ==================================================\n",
    "# MATCH STATISTICS\n",
    "# ==================================================\n",
    "print(\"\\n==============================\")\n",
    "print(\"MERGING RESULTS\")\n",
    "print(\"==============================\")\n",
    "print(f\"Total number of rows:               {len(step1):,}\")\n",
    "print(f\"Total number of EVs matched:        {matched:,}\")\n",
    "print(f\"Total number of EVs unmatched:      {unmatched:,}\")\n",
    "print(f\"Match rate:                         {matched/len(step1)*100:.2f}%\\n\")\n",
    "print(f\"Distinct number of EV brands:       {matched_brands}\")\n",
    "print(f\"Distinct number of EV models:       {matched_models:,}\\n\")\n",
    "print(f\"Matched in upper level (step 1):    {step1_models:,}\")\n",
    "print(f\"Matched in lower level (step 2):    {step2_models:,}\")\n",
    "print(f\"EV statistics not found:            {unmatched_models:,}\")\n",
    "\n",
    "print(\"\\n===================================\")\n",
    "print(\"USABLE BATTERY CAPACITY UNCERTAINTY\")\n",
    "print(\"===================================\")\n",
    "print(f\"Average uncertainty: {battery_unc.mean()*100:.2f}%\")\n",
