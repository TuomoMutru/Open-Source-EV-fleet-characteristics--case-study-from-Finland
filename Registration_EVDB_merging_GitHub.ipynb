   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "232ba8d8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['id', 'model_id', 'brand', 'model_name', 'variant_name', 'model_year', 'original_variants', 'body_style', 'segment', 'battery_capacity_kwh', 'battery_usable_kwh', 'battery_chemistry', 'battery_warranty_years', 'battery_warranty_km', 'range_wltp_km', 'range_real_world_km', 'range_epa_km', 'consumption_wltp_kwh_100km', 'consumption_real_world_kwh_100km', 'ac_charge_power_kw', 'ac_charge_phase', 'dc_charge_power_kw', 'dc_peak_power_kw', 'dc_charge_time_10_80_min', 'dc_charge_time_0_100_min', 'connector_types', 'bidirectional_charging', 'bidirectional_power_kw']\n",
      "(526, 28)\n",
      "Maximum hierarchy depth: 10\n",
      "EV statistics merged by 'brand_model' - logic to a output file:\n",
      "C:\\...\\EVDB_brand_model_statistics.csv\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import re\n",
    "import json\n",
    "\n",
    "# ==================================================\n",
    "# READ EVDB CSV\n",
    "# ==================================================\n",
    "\n",
    "# Root folder\n",
    "ROOT_FOLDER = r'C:\\...'\n",
    "\n",
    "# Initially using same file, which was created in previous code. Alternatively copy the csv file, which is created based on (https://github.com/gaia-charge/evdb) query\n",
    "EVDB_FILE = ROOT_FOLDER + \"\\\\\" + output_file\n",
    "\n",
    "evdb = pd.read_csv(EVDB_FILE, sep=\";\", decimal=\",\", encoding=\"utf-8-sig\")\n",
    "\n",
    "print(evdb.columns.tolist())\n",
    "print(evdb.shape)\n",
    "\n",
    "EVDB_BRAND_ALIASES = {\n",
    "    \"ALFA ROMEO\": \"ALFAROMEO\",\n",
    "    \"DS AUTOMOBILES\": \"DS\",\n",
    "    \"LYNK & CO\": \"LYNK&CO\",\n",
    "    \"MERCEDES-BENZ\": \"MERCEDESBENZ\",\n",
    "    \"ROLLS-ROYCE\": \"ROLLSROYCE\",\n",
    "}\n",
    "\n",
    "def model_fix_hierarchy(model, brand):\n",
    "\n",
    "    m = strip_leading_brand_from_model(model, brand)\n",
    "\n",
    "    if m is None:\n",
    "        return None\n",
    "\n",
    "    for ch in [\"-\",\"/\",\"_\",\".\",\",\",\";\", \"(\",\")\",\"!\",\"?\"]:\n",
    "        m = m.replace(ch, \" \")\n",
    "\n",
    "    m = m.replace(\" E TRON \", \" ETRON \")\n",
    "    m = m.replace(\" E- TRON \", \" ETRON \")\n",
    "    m = m.replace(\"ID . \", \"ID \")\n",
    "    m = m.replace(\"ID. \", \"ID \")\n",
    "    m = m.replace(\"ID.\", \"ID\")\n",
    "\n",
    "    if brand == \"AUDI\":\n",
    "\n",
    "        tokens = m.split()\n",
    "        tokens = [\"AVANT\" if t == \"AV\" else \"SPORTBACK\" if t == \"SB\" else t for t in tokens]\n",
    "        m = \" \".join(tokens)\n",
    "\n",
    "    m = re.sub(r\"[^A-Z0-9#+X ]\", \"\", m)\n",
    "    m = \" \".join(m.split())\n",
    "\n",
    "    return m\n",
    "\n",
    "def evdb_brand_alias(brand):\n",
    "\n",
    "    if pd.isna(brand):\n",
    "        return None\n",
    "\n",
    "    brand = normalize(brand)\n",
    "\n",
    "    return EVDB_BRAND_ALIASES.get(brand, brand.replace(\" \", \"\"))\n",
    "\n",
    "def create_evdb_brand_model_hierarchy(row):\n",
    "\n",
    "    brand = evdb_brand_alias(row[\"brand\"])\n",
    "    model = model_fix_hierarchy(row[\"model_name\"], brand)\n",
    "    variant = model_fix_hierarchy(row[\"variant_name\"], brand)\n",
    "\n",
    "    if not brand:\n",
    "        return []\n",
    "\n",
    "    words = []\n",
    "\n",
    "    if model:\n",
    "        words.extend(model.split())\n",
    "\n",
    "    if variant:\n",
    "        words.extend(variant.split())\n",
    "\n",
    "    hierarchy = []\n",
    "\n",
    "    while len(words) > 1:\n",
    "        hierarchy.append(f\"{brand}_{''.join(words)}\")\n",
    "\n",
    "        words.pop()\n",
    "\n",
    "    # last remaining word = base model\n",
    "    hierarchy.append(f\"{brand}_{words[0]}\")\n",
    "    \n",
    "    return hierarchy\n",
    "\n",
    "hierarchies = evdb.apply(create_evdb_brand_model_hierarchy, axis=1)\n",
    "max_levels = hierarchies.str.len().max()\n",
    "\n",
    "print(f\"Maximum hierarchy depth: {max_levels}\")\n",
    "\n",
    "for i in range(max_levels):\n",
    "    evdb[f\"BRAND_MODEL_{i+1}\"] = (hierarchies.apply(lambda x: x[i] if i < len(x) else None))\n",
    "\n",
    "validation_cols = [\"brand\", \"model_name\", \"variant_name\", \"model_id\"]\n",
    "validation_cols.extend([f\"BRAND_MODEL_{i+1}\" for i in range(max_levels)])\n",
    "validation = (evdb[validation_cols].sort_values([\"brand\", \"model_name\"]))\n",
    "validation.to_csv(\"EVDB_brand_model_hierarchy_validation.csv\", sep=\";\", index=False, encoding=\"utf-8-sig\")\n",
    "\n",
    "# Add the ev statistics to each \"brand_model\" level\n",
    "brand_model_cols = [c for c in evdb.columns if c.startswith(\"BRAND_MODEL_\")]\n",
    "\n",
    "hierarchy_long = evdb.melt(\n",
    "    id_vars=[\n",
    "        \"model_id\",\n",
    "        \"original_variants\",\n",
    "        \"battery_usable_kwh\",\n",
    "        \"range_wltp_km\",\n",
    "        \"consumption_wltp_kwh_100km\"\n",
    "    ],\n",
    "    value_vars=brand_model_cols,\n",
    "    value_name=\"brand_model\"\n",
    ")\n",
    "\n",
    "hierarchy_long = hierarchy_long.dropna(subset=[\"brand_model\"])\n",
    "\n",
    "def unique_values(series):\n",
    "\n",
    "    values = []\n",
    "\n",
    "    for v in series.dropna():\n",
    "\n",
    "        # handle JSON lists\n",
    "        if isinstance(v, str):\n",
    "\n",
    "            try:\n",
    "                parsed = json.loads(v)\n",
    "\n",
    "                if isinstance(parsed, list):\n",
    "                    values.extend(parsed)\n",
    "                else:\n",
    "                    values.append(parsed)\n",
    "\n",
    "            except Exception:\n",
    "                values.append(v)\n",
    "\n",
    "        elif isinstance(v, list):\n",
    "            values.extend(v)\n",
    "\n",
    "        else:\n",
    "            values.append(v)\n",
    "\n",
    "    values = sorted({str(x).strip() for x in values if str(x).strip() != \"\"})\n",
    "\n",
    "    return json.dumps(values)\n",
    "\n",
    "numeric_cols = [\n",
    "    \"battery_capacity_kwh\",\n",
    "    \"battery_usable_kwh\",\n",
    "    \"range_wltp_km\",\n",
    "    \"range_real_world_km\",\n",
    "    \"consumption_wltp_kwh_100km\",\n",
    "    \"consumption_real_world_kwh_100km\"\n",
    "]\n",
    "\n",
    "list_cols = [\n",
    "    \"brand\",\n",
    "    \"model_name\",\n",
    "    \"variant_name\",\n",
    "    \"model_year\",\n",
    "    \"body_style\",\n",
    "    \"segment\",\n",
    "    \"battery_chemistry\",\n",
    "    \"battery_warranty_years\",\n",
    "    \"battery_warranty_km\",\n",
    "    \"ac_charge_power_kw\",\n",
    "    \"ac_charge_phase\",\n",
    "    \"dc_charge_power_kw\",\n",
    "    \"dc_peak_power_kw\",\n",
    "    \"dc_charge_time_10_80_min\",\n",
    "    \"dc_charge_time_0_100_min\",\n",
    "    \"connector_types\",\n",
    "    \"bidirectional_charging\",\n",
    "    \"bidirectional_power_kw\"\n",
    "]\n",
    "\n",
    "agg_dict = {}\n",
    "\n",
    "for col in numeric_cols:\n",
    "    agg_dict[f\"{col}_min\"] = (col, \"min\")\n",
    "    agg_dict[f\"{col}_max\"] = (col, \"max\")\n",
    "    agg_dict[f\"{col}_mean\"] = (col, \"mean\")\n",
    "    agg_dict[f\"{col}_median\"] = (col, \"median\")\n",
    "\n",
    "for col in list_cols:\n",
    "    agg_dict[col] = (col, unique_values)\n",
    "\n",
    "hierarchy_long = evdb.melt(\n",
    "    id_vars=[\n",
    "        \"model_id\",\n",
    "        \"original_variants\",\n",
    "        \"brand\",\n",
    "        \"model_name\",\n",
    "        \"variant_name\",\n",
    "        \"battery_capacity_kwh\",\n",
    "        \"battery_usable_kwh\",\n",
    "        \"model_year\",\n",
    "        \"body_style\",\n",
    "        \"segment\",\n",
    "        \"battery_chemistry\",\n",
    "        \"battery_warranty_years\",\n",
    "        \"battery_warranty_km\",\n",
    "        \"range_wltp_km\",\n",
    "        \"range_real_world_km\",\n",
    "        \"range_epa_km\",\n",
    "        \"consumption_wltp_kwh_100km\",\n",
    "        \"consumption_real_world_kwh_100km\",\n",
    "        \"ac_charge_power_kw\",\n",
    "        \"ac_charge_phase\",\n",
    "        \"dc_charge_power_kw\",\n",
    "        \"dc_peak_power_kw\",\n",
    "        \"dc_charge_time_10_80_min\",\n",
    "        \"dc_charge_time_0_100_min\",\n",
    "        \"connector_types\",\n",
    "        \"bidirectional_charging\",\n",
    "        \"bidirectional_power_kw\"\n",
    "    ],\n",
    "    value_vars=brand_model_cols,\n",
    "    value_name=\"brand_model\"\n",
    ")\n",
    "\n",
    "# Count vehicles within the same brand_model hierarchy level and number of original variants\n",
    "agg_dict = {\n",
    "    \"vehicle_count\": ( \"model_id\", \"nunique\"),\n",
    "    \"original_variants_count\": (\"original_variants\", \"sum\")\n",
    "}\n",
    "\n",
    "for col in numeric_cols:\n",
    "\n",
    "    # Min\n",
    "    agg_dict[f\"{col}_min\"] = (col, \"min\")\n",
    "\n",
    "    # Max\n",
    "    agg_dict[f\"{col}_max\"] = (col, \"max\")\n",
    "\n",
    "    # Mean\n",
    "    agg_dict[f\"{col}_mean\"] = ( col, \"mean\")\n",
    "\n",
    "    # Median\n",
    "    agg_dict[f\"{col}_median\"] = (col, \"median\")\n",
    "\n",
    "for col in list_cols:\n",
    "    agg_dict[col] = (col, unique_values)\n",
    "\n",
    "summary = (hierarchy_long.groupby(\"brand_model\").agg(**agg_dict).reset_index())\n",
    "\n",
    "for col in numeric_cols:\n",
    "    # Uncertainty = Coefficient of Variation (CV) = std / mean\n",
    "    summary[f\"{col}_spread\"] = (summary[f\"{col}_max\"] - summary[f\"{col}_min\"])\n",
    "    summary[f\"{col}_relative_spread\"] = (summary[f\"{col}_max\"] - summary[f\"{col}_min\"]) / (2*summary[f\"{col}_median\"])\n",
    "\n",
    "# Overall uncertainty based on relative spread\n",
    "spread_cols = [f\"{col}_relative_spread\" for col in numeric_cols]\n",
    "summary[\"overall_uncertainty\"] = (summary[spread_cols].mean(axis=1))\n",
    "\n",
    "# Average uncertainty for the usable battery and WLTP energy consumption levels\n",
    "usable_bat_WLTP_cons = [\"consumption_wltp_kwh_100km\", \"battery_usable_kwh\"]\n",
    "usable_bat_WLTP_cons_cols = [f\"{col}_relative_spread\" for col in usable_bat_WLTP_cons]\n",
    "summary[\"usable_batt_WLTP_cons_uncertainty\"] = (summary[usable_bat_WLTP_cons_cols].mean(axis=1))\n",
    "\n",
    "output_file = (f\"EVDB_brand_model_statistics.csv\")\n",
    "\n",
    "summary.to_csv(output_file, sep=\";\", decimal=\",\", index=False, encoding=\"utf-8-sig\")\n",
    "\n",
    "print(f\"EV statistics merged by 'brand_model' - logic to a output file:\\n{Path(output_file).resolve()}\")"
   ]
  },
