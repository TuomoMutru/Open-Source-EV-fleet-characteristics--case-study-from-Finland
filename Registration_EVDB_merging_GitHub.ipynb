   "source": [
    "\"\"\"\n",
    "First, the registration data is filtered by EVs, data is cleaned and the dataset is processed to consider \"BRAND_MODEL\" logic\n",
    "\n",
    "Data source: https://opendata.traficom.fi/Content/Ajoneuvorekisteri.zip, under licence CC BY-SA 4.0\n",
    "\n",
    "\"\"\"\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import re\n",
    "from tqdm import tqdm\n",
    "\n",
    "tqdm.pandas()\n",
    "\n",
    "# ==================================================\n",
    "# LOAD INPUT DATA AND DETERMINE OUTPUT DATA\n",
    "# ==================================================\n",
    "\n",
    "# Working folder\n",
    "ROOT_FOLDER = r'C:\\...'\n",
    "\n",
    "# Input datasets\n",
    "INPUT_FILE = ROOT_FOLDER + (r'\\TieliikenneAvoinData_31_12_2025.csv')\n",
    "MAPPING_FILE = ROOT_FOLDER + (r'\\TieliikenneAvoinData_31_12_2025_EV_model_matching_map.csv')\n",
    "\n",
    "# Output dataset\n",
    "OUTPUT_FILE = ROOT_FOLDER + (r'\\TieliikenneAvoinData_31_12_2025_cleaned.csv')\n",
    "\n",
    "# ==================================================\n",
    "# USER SETTINGS\n",
    "# ==================================================\n",
    "\n",
    "MIN_REGISTRATION_DATE = \"2006-01-01\"\n",
    "\n",
    "ALLOWED_VEHICLE_CLASSES = [\"M1\", \"M1G\", \"N1\", \"N1G\"]\n",
    "\n",
    "ELECTRIC_POWERTRAIN_CODE = 4\n",
    "\n",
    "# ==================================================\n",
    "# LOGGING\n",
    "# ==================================================\n",
    "\n",
    "def stage(message):\n",
    "    print(\"\\n\" + \"=\" * 80)\n",
    "    print(message)\n",
    "    print(\"=\" * 80)\n",
    "\n",
    "# ==================================================\n",
    "# VALIDATION\n",
    "# ==================================================\n",
    "\n",
    "def print_stats(df, stage):\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(stage)\n",
    "    print(\"=\" * 60)\n",
    "\n",
    "    print(f\"Rows: {len(df):,}\")\n",
    "\n",
    "    if \"brand_model\" in df.columns:\n",
    "\n",
    "        print(\n",
    "            f\"Unique brand_model: \"\n",
    "            f\"{df['brand_model'].nunique(dropna=True):,}\"\n",
    "        )\n",
    "\n",
    "        print(\n",
    "            f\"Missing brand_model: \"\n",
    "            f\"{df['brand_model'].isna().sum():,}\"\n",
    "        )\n",
    "\n",
    "\n",
    "# --------------------------------------------------\n",
    "# SAFE CONVERTERS\n",
    "# --------------------------------------------------\n",
    "\n",
    "def to_int(x):\n",
    "\n",
    "    if pd.isna(x):\n",
    "        return pd.NA\n",
    "\n",
    "    try:\n",
    "        x = str(x).strip().replace(\",\", \".\")\n",
    "        return int(float(x))\n",
    "    except:\n",
    "        return pd.NA\n",
    "\n",
    "\n",
    "def to_date(x):\n",
    "\n",
    "    if pd.isna(x):\n",
    "        return pd.NaT\n",
    "\n",
    "    try:\n",
    "        return pd.to_datetime(\n",
    "            str(x).strip(),\n",
    "            format=\"%d.%m.%Y\",\n",
    "            errors=\"coerce\"\n",
    "        )\n",
    "    except:\n",
    "        return pd.NaT\n",
    "\n",
    "\n",
    "def to_bool(x):\n",
    "\n",
    "    if pd.isna(x):\n",
    "        return pd.NA\n",
    "\n",
    "    u = str(x).strip().upper()\n",
    "\n",
    "    if u in [\"TRUE\", \"T\", \"YES\", \"Y\", \"1\"]:\n",
    "        return True\n",
    "\n",
    "    if u in [\"FALSE\", \"F\", \"NO\", \"N\", \"0\"]:\n",
    "        return False\n",
    "\n",
    "    return pd.NA\n",
    "\n",
    "# --------------------------------------------------\n",
    "# NORMALIZATION\n",
    "# --------------------------------------------------\n",
    "\n",
    "ACCENT_MAP = {\n",
    "    \"Ä\":\"A\", \"Å\":\"A\", \"Æ\":\"AE\", \"Ö\":\"O\", \"Ø\":\"O\", \"Ü\":\"U\",\n",
    "    \"É\":\"E\", \"È\":\"E\", \"Ê\":\"E\", \"Ë\":\"E\",\n",
    "    \"Á\":\"A\", \"À\":\"A\", \"Â\":\"A\", \"Ã\":\"A\",\n",
    "    \"Ó\":\"O\", \"Ò\":\"O\", \"Ô\":\"O\", \"Õ\":\"O\",\n",
    "    \"Í\":\"I\", \"Ì\":\"I\", \"Î\":\"I\", \"Ï\":\"I\",\n",
    "    \"Ú\":\"U\", \"Ù\":\"U\", \"Û\":\"U\",\n",
    "    \"Ç\":\"C\", \"Ñ\":\"N\", \"Š\":\"S\", \"Ž\":\"Z\", \"Œ\":\"OE\"\n",
    "}\n",
    "\n",
    "def normalize(text):\n",
    "\n",
    "    if pd.isna(text):\n",
    "        return None\n",
    "\n",
    "    text = str(text).strip().upper()\n",
    "\n",
    "    for old, new in ACCENT_MAP.items():\n",
    "        text = text.replace(old, new)\n",
    "\n",
    "    return text\n",
    "\n",
    "\n",
    "# --------------------------------------------------\n",
    "# BRAND ALIAS\n",
    "# --------------------------------------------------\n",
    "\n",
    "def brand_alias(brand):\n",
    "\n",
    "    b = normalize(brand)\n",
    "\n",
    "    if b is None:\n",
    "        return None\n",
    "\n",
    "    b_clean = re.sub(\n",
    "        r\"[.,;:/\\\\()\\[\\]{}!?'`´^~]\",\n",
    "        \" \",\n",
    "        b\n",
    "    )\n",
    "\n",
    "    b_clean = \" \".join(\n",
    "        x for x in b_clean.split()\n",
    "        if x\n",
    "    )\n",
    "\n",
    "    b_bare = re.sub(\n",
    "        r\"[^A-Z0-9]\",\n",
    "        \"\",\n",
    "        b_clean\n",
    "    )\n",
    "\n",
    "    if b_bare == \"BWW\":\n",
    "        mapped = \"BMW\"\n",
    "\n",
    "    elif b_bare == \"BMWI\":\n",
    "        mapped = \"BMW\"\n",
    "\n",
    "    elif b_bare == \"TESLAMOTORS\":\n",
    "        mapped = \"TESLA\"\n",
    "\n",
    "    elif b_bare == \"VW\":\n",
    "        mapped = \"VOLKSWAGEN\"\n",
    "\n",
    "    elif b_bare.startswith(\"VOLKSWAGEN\"):\n",
    "        mapped = \"VOLKSWAGEN\"\n",
    "\n",
    "    elif b_bare == \"JAGUARLANDROVERLIMITED\":\n",
    "        mapped = \"JAGUAR\"\n",
    "\n",
    "    elif b_bare == \"DSAUTOMOBILES\":\n",
    "        mapped = \"DS\"\n",
    "\n",
    "    elif b_bare in [\"HUNDAI\", \"HYNDAI\"]:\n",
    "        mapped = \"HYUNDAI\"\n",
    "\n",
    "    else:\n",
    "        mapped = b_clean\n",
    "\n",
    "    mapped = re.sub(\n",
    "        r\"[^A-Z0-9& ]\",\n",
    "        \"\",\n",
    "        mapped\n",
    "    )\n",
    "\n",
    "    return mapped.replace(\" \", \"\")\n",
    "\n",
    "# --------------------------------------------------\n",
    "# REMOVE MODEL PREFIX\n",
    "# --------------------------------------------------\n",
    "\n",
    "def strip_leading_brand_from_model(model, brand):\n",
    "\n",
    "    model = normalize(model)\n",
    "\n",
    "    if model is None:\n",
    "        return None\n",
    "\n",
    "    if brand is None:\n",
    "        return model\n",
    "\n",
    "    if brand == \"MERCEDESBENZ\":\n",
    "\n",
    "        variants = [\n",
    "            \"MERCEDESBENZ\",\n",
    "            \"MERCEDES-BENZ\",\n",
    "            \"MERCEDES BENZ\",\n",
    "            \"MERCEDES\",\n",
    "            \"BENZ\",\n",
    "            \"MB\"\n",
    "        ]\n",
    "\n",
    "    elif brand in [\"LYNK&CO\", \"LYNKANDCO\"]:\n",
    "\n",
    "        variants = [\n",
    "            \"LYNK&CO\",\n",
    "            \"LYNK & CO\",\n",
    "            \"LYNK& CO\",\n",
    "            \"LYNK AND CO\",\n",
    "            \"LYNKANDCO\",\n",
    "            \"LYNKCO\"\n",
    "        ]\n",
    "\n",
    "    else:\n",
    "\n",
    "        variants = [\n",
    "            brand,\n",
    "            \" \".join(list(brand))\n",
    "        ]\n",
    "\n",
    "    for _ in range(2):\n",
    "\n",
    "        for prefix in variants:\n",
    "\n",
    "            p = prefix + \" \"\n",
    "\n",
    "            if model.startswith(p):\n",
    "                model = model[len(p):]\n",
    "\n",
    "    return model\n",
    "\n",
    "# --------------------------------------------------\n",
    "# MODEL FIX\n",
    "# --------------------------------------------------\n",
    "\n",
    "def model_fix(model, brand):\n",
    "\n",
    "    m = strip_leading_brand_from_model(\n",
    "        model,\n",
    "        brand\n",
    "    )\n",
    "\n",
    "    if m is None:\n",
    "        return None\n",
    "\n",
    "    for ch in [\n",
    "        \"-\",\"/\",\"_\",\".\",\",\",\";\",\n",
    "        \"(\",\")\",\"!\",\"?\"\n",
    "    ]:\n",
    "        m = m.replace(ch, \" \")\n",
    "\n",
    "    m = m.replace(\n",
    "        \" E TRON \",\n",
    "        \" E-TRON \"\n",
    "    )\n",
    "\n",
    "    m = m.replace(\n",
    "        \" ETRON \",\n",
    "        \" E-TRON \"\n",
    "    )\n",
    "\n",
    "    m = m.replace(\n",
    "        \" E- TRON \",\n",
    "        \" E-TRON \"\n",
    "    )\n",
    "\n",
    "    m = m.replace(\"ID . \", \"ID\")\n",
    "    m = m.replace(\"ID. \", \"ID\")\n",
    "    m = m.replace(\"ID.\", \"ID\")\n",
    "\n",
    "    if brand == \"AUDI\":\n",
    "\n",
    "        tokens = m.split()\n",
    "\n",
    "        tokens = [\n",
    "            \"AVANT\" if t == \"AV\"\n",
    "            else \"SPORTBACK\" if t == \"SB\"\n",
    "            else t\n",
    "            for t in tokens\n",
    "        ]\n",
    "\n",
    "        m = \" \".join(tokens)\n",
    "\n",
    "    spec_words = {\n",
    "        \"PURE\",\n",
    "        \"PRO4MOTION\",\n",
    "        \"PRO\",\n",
    "        \"GTX\",\n",
    "        \"TOURER\",\n",
    "        \"BUZZ\"\n",
    "    }\n",
    "\n",
    "    tokens = m.split()\n",
    "\n",
    "    idx = None\n",
    "\n",
    "    for i, t in enumerate(tokens):\n",
    "\n",
    "        if t in spec_words:\n",
    "            idx = i\n",
    "            break\n",
    "\n",
    "    if idx is not None:\n",
    "        m = \" \".join(tokens[:idx+1])\n",
    "\n",
    "    m = \"\".join(m.split())\n",
    "\n",
    "    m = re.sub(\n",
    "        r\"[^A-Z0-9#+X]\",\n",
    "        \"\",\n",
    "        m\n",
    "    )\n",
    "\n",
    "    return m\n",
    "\n",
    "# --------------------------------------------------\n",
    "# TESLA CANONICALIZATION\n",
    "# --------------------------------------------------\n",
    "\n",
    "def tesla_canon(model):\n",
    "\n",
    "    if model is None:\n",
    "        return None\n",
    "\n",
    "    model = model.replace(\n",
    "        \"MODELL\",\n",
    "        \"MODEL\"\n",
    "    )\n",
    "\n",
    "    model = model.replace(\n",
    "        \"MODESS\",\n",
    "        \"MODELS\"\n",
    "    )\n",
    "\n",
    "    model = model.replace(\n",
    "        \"MODES\",\n",
    "        \"MODELS\"\n",
    "    )\n",
    "\n",
    "    if (\n",
    "        \"85\" in model or\n",
    "        model == \"P75\" or\n",
    "        model == \"VIOEUROPE\"\n",
    "    ):\n",
    "        return \"MODELS85D\"\n",
    "\n",
    "    if model.startswith(\"MODEL\"):\n",
    "\n",
    "        ch = model[5:6]\n",
    "\n",
    "        if ch == \"3\":\n",
    "            return \"MODEL3\"\n",
    "\n",
    "        if ch == \"S\":\n",
    "            return \"MODELS\"\n",
    "\n",
    "        if ch == \"X\":\n",
    "            return \"MODELX\"\n",
    "\n",
    "        if ch == \"Y\":\n",
    "            return \"MODELY\"\n",
    "\n",
    "    if model == \"S\":\n",
    "        return \"MODELS\"\n",
    "\n",
    "    if model == \"X\":\n",
    "        return \"MODELX\"\n",
    "\n",
    "    if model == \"Y\":\n",
    "        return \"MODELY\"\n",
    "\n",
    "    if model == \"3\":\n",
    "        return \"MODEL3\"\n",
    "\n",
    "    return model\n",
    "\n",
    "# ==================================================\n",
    "# READ DATA\n",
    "# ==================================================\n",
    "\n",
    "stage(\"STEP 1/4 - Loading CSV file...\")\n",
    "\n",
    "df = pd.read_csv(\n",
    "    INPUT_FILE,\n",
    "    sep=\";\",\n",
    "    encoding=\"cp1252\",\n",
    "    dtype=str,\n",
    "    low_memory=False\n",
    ")\n",
    "\n",
    "print(f\"Loaded {len(df):,} rows.\\n\")\n",
    "\n",
    "# ==================================================\n",
    "# FILTER DATA\n",
    "# ==================================================\n",
    "\n",
    "stage(\"STEP 2/4 - Filtering EV registrations...\")\n",
    "\n",
    "rows_before = len(df)\n",
    "\n",
    "df = df[df[\"ajoneuvoluokka\"].isin(ALLOWED_VEHICLE_CLASSES)]\n",
    "print(f\"Vehicle class filter: \"f\"{rows_before:,} -> {len(df):,}\\n\")\n",
    "\n",
    "rows_before = len(df)\n",
    "\n",
    "# make sure that the traction type is in int\n",
    "df[\"kayttovoima\"] = (\n",
    "    df[\"kayttovoima\"]\n",
    "    .apply(to_int)\n",
    ")\n",
    "\n",
    "df = df[df[\"kayttovoima\"]== ELECTRIC_POWERTRAIN_CODE]\n",
    "print(f\"Powertrain filter: \"f\"{rows_before:,} -> {len(df):,}\\n\")\n",
    "\n",
    "rows_before = len(df)\n",
    "\n",
    "# make sure that the registration date is in date format\n",
    "df[\"ensirekisterointipvm\"] = (\n",
    "    df[\"ensirekisterointipvm\"]\n",
    "    .apply(to_date)\n",
    ")\n",
    "\n",
    "df = df[df[\"ensirekisterointipvm\"] > pd.Timestamp(MIN_REGISTRATION_DATE)]\n",
    "print(f\"Date filter: \"f\"{rows_before:,} -> {len(df):,}\\n\")\n",
    "\n",
    "# ==================================================\n",
    "# TYPE CONVERSIONS\n",
    "# ==================================================\n",
    "\n",
    "stage(\"STEP 3/4 - Type conversions...\")\n",
    "\n",
    "df[\"kunta\"] = (\n",
    "    df[\"kunta\"]\n",
    "    .apply(to_int)\n",
    ")\n",
    "\n",
    "df[\"matkamittarilukema\"] = (\n",
    "    df[\"matkamittarilukema\"]\n",
    "    .apply(to_int)\n",
    ")\n",
    "\n",
    "print(\"Type conversions completed.\\n\")\n",
    "\n",
    "# ==================================================\n",
    "# CREATE BRAND_MODEL\n",
    "# ==================================================\n",
    "\n",
    "def make_brand_model(row):\n",
    "\n",
    "    brand = brand_alias(\n",
    "        row[\"merkkiSelvakielinen\"]\n",
    "    )\n",
    "\n",
    "    model = model_fix(\n",
    "        row[\"kaupallinenNimi\"],\n",
    "        brand\n",
    "    )\n",
    "\n",
    "    if brand == \"TESLA\":\n",
    "        model = tesla_canon(model)\n",
    "\n",
    "    if (\n",
    "        brand is None or\n",
    "        brand == \"\" or\n",
    "        model is None or\n",
    "        model == \"\"\n",
    "    ):\n",
    "        return None\n",
    "\n",
    "    return f\"{brand}_{model}\"\n",
    "\n",
    "stage(\"STEP 4/4 - Generating brand_model...\")\n",
    "\n",
    "df[\"brand_model\"] = df.progress_apply(\n",
    "    make_brand_model,\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "# ==========================================================================================================\n",
    "# SOME NAMES ARE STILL MISPELLED OR WRONG, LOAD BRAND_MODEL_NEW MAPPING TO HAVE CLEANER BRAND_MODEL VERSION\n",
    "# ==========================================================================================================\n",
    "\n",
    "mapping = pd.read_csv(MAPPING_FILE, sep=\";\", dtype=str, encoding=\"utf-8-sig\")\n",
    "\n",
    "# remove possible duplicates\n",
    "mapping = (\n",
    "    mapping[\n",
    "        [\"brand_model\", \"brand_model_new\"]\n",
    "    ]\n",
    "    .dropna(subset=[\"brand_model\"])\n",
    "    .drop_duplicates(subset=[\"brand_model\"])\n",
    ")\n",
    "\n",
    "# ==================================================\n",
    "# REMOVE INVALID / UNWANTED BRAND_MODELS\n",
    "# ==================================================\n",
    "\n",
    "EXCLUDED_BRAND_MODELS = {\n",
    "    \"JEEP_PATRIOT\",\n",
    "    \"MERCEDESBENZ_B200ELECTRICDRIVE\",\n",
    "    \"MERCEDESBENZ_VKLASSE\",\n",
    "    \"ROVER_MINIMKII\",\n",
    "    \"VOLKSWAGEN_KLEINBUS\",\n",
    "    \"VOYAH_FREE\"\n",
    "}\n",
    "\n",
    "rows_before = len(df)\n",
    "\n",
    "df = df[df[\"brand_model\"].notna() & ~df[\"brand_model\"].isin(EXCLUDED_BRAND_MODELS)].copy()\n",
    "\n",
    "print(f\"Brand_model cleanup: {rows_before:,} -> {len(df):,} ({rows_before - len(df):,} rows removed)\")\n",
    "\n",
    "# ==================================================\n",
    "# ADD brand_model_new\n",
    "# ==================================================\n",
    "\n",
    "df = df.merge( mapping, on=\"brand_model\", how=\"left\")\n",
    "\n",
    "print(f\"brand_model_new matches found: {df['brand_model_new'].notna().sum():,}\")\n",
    "print(f\"brand_model_new missing: {df['brand_model_new'].isna().sum():,}\")\n",
    "print_stats(df, \"Final dataset results:\")\n",
    "\n",
    "# ==================================================\n",
    "# EXPORT BRAND_MODEL COUNTS\n",
    "# ==================================================\n",
    "\n",
    "brand_model_summary = (\n",
    "    df[\"brand_model\"]\n",
    "    .value_counts(dropna=False)\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "brand_model_summary.columns = [\n",
    "    \"brand_model\",\n",
    "    \"count\"\n",
    "]\n",
    "\n",
    "brand_model_summary = brand_model_summary.sort_values(\n",
    "    \"brand_model\",\n",
    "    na_position=\"last\"\n",
    ")\n",
    "\n",
    "brand_model_summary.to_csv(\n",
    "OUTPUT_FILE.replace(\n",
    "        \".csv\",\n",
    "        \"_brand_model_summary.csv\"\n",
    "    ),\n",
    "    sep=\";\",\n",
    "    index=False,\n",
    "    encoding=\"utf-8-sig\"\n",
    ")\n",
    "\n",
    "print(f\"\\nSaved brand_model counts: {OUTPUT_FILE.replace('.csv', '_brand_model_summary.csv')}\")\n",
    "\n",
    "# ==================================================\n",
    "# EXPORT BRAND_MODEL COUNTS WITH ORIG NAMES\n",
    "# ==================================================\n",
    "\n",
    "brand_model_validation = (\n",
    "    df.groupby(\"brand_model\", dropna=False)\n",
    "    .agg(\n",
    "        count=(\"brand_model\", \"size\"),\n",
    "        brands=(\n",
    "            \"merkkiSelvakielinen\",\n",
    "            lambda x: \" | \".join(\n",
    "                sorted(\n",
    "                    set(\n",
    "                        str(v)\n",
    "                        for v in x.dropna()\n",
    "                    )\n",
    "                )\n",
    "            )\n",
    "        ),\n",
    "        models=(\n",
    "            \"kaupallinenNimi\",\n",
    "            lambda x: \" | \".join(\n",
    "                sorted(\n",
    "                    set(\n",
    "                        str(v)\n",
    "                        for v in x.dropna()\n",
    "                    )\n",
    "                )\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "brand_model_validation = (\n",
    "    brand_model_validation\n",
    "    .sort_values(\n",
    "        \"brand_model\",\n",
    "        na_position=\"last\"\n",
    "    )\n",
    ")\n",
    "\n",
    "brand_model_validation.to_csv(\n",
    "    OUTPUT_FILE.replace(\n",
    "            \".csv\", \n",
    "            \"_brand_model_validation.csv\"\n",
    "        ), \n",
    "        sep=\";\", \n",
    "        index=False, \n",
    "        encoding=\"utf-8-sig\"\n",
    ")\n",
    "\n",
    "print(f\"\\nSaved brand_model validation: {OUTPUT_FILE.replace('.csv', '_brand_model_validation.csv')}\")\n",
    "\n",
    "# ==================================================\n",
    "# EXPORT UNMATCHED BRAND_MODELS\n",
    "# ==================================================\n",
    "\n",
    "missing_brand_model = (\n",
    "    df[df[\"brand_model\"].isna()]\n",
    "    [\n",
    "        [\n",
    "            \"merkkiSelvakielinen\",\n",
    "            \"kaupallinenNimi\"\n",
    "        ]\n",
    "    ]\n",
    "    .value_counts()\n",
    "    .reset_index(name=\"count\")\n",
    ")\n",
    "\n",
    "missing_brand_model = missing_brand_model.sort_values(\n",
    "    [\n",
    "        \"merkkiSelvakielinen\",\n",
    "        \"kaupallinenNimi\"\n",
    "    ]\n",
    ")\n",
    "\n",
    "missing_brand_model.to_csv(OUTPUT_FILE.replace(\".csv\", \"_brand_model_missing.csv\"), sep=\";\", index=False, encoding=\"utf-8-sig\")\n",
    "print(f\"\\nMissing brand_models: {OUTPUT_FILE.replace('.csv', '_brand_model_missing.csv')}\")\n",
    "\n",
    "# ==================================================\n",
    "# EXPORT CLEANED EV DATASET\n",
    "# ==================================================\n",
    "\n",
    "df.to_csv(OUTPUT_FILE, sep=\";\", index=False, encoding=\"utf-8-sig\")\n",
    "print(f\"\\nSaved cleaned dataset:\\n{OUTPUT_FILE}\")"
   ]
  },
